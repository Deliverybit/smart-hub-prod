# Copy to .env for local scripts (migrations, exports). Do not commit.

APP_ENV=production

# Supabase smart-hub-prod → Connect → Session pooler → URI
DATABASE_URL=postgresql://postgres.nfyccectlkvvmemveoxn:[YOUR-PASSWORD]@aws-0-ca-central-1.pooler.supabase.com:5432/postgres?sslmode=require

ALPHA_VANTAGE_API_KEY=replace-with-your-alpha-vantage-key
EODHD_API_KEY=replace-with-your-eodhd-key

# X app scoop52-poster. OAuth 1.0a user keys for @TheScoop52.
# Developer Portal → Keys and tokens → Access Token and Secret.
# These do not expire, so a cron job can reuse the same four values.
X_API_KEY=replace-with-consumer-key
X_API_SECRET=replace-with-consumer-secret
X_ACCESS_TOKEN=replace-with-access-token
X_ACCESS_TOKEN_SECRET=replace-with-access-token-secret
SCREENER_SYMBOL_LIMIT=1000
