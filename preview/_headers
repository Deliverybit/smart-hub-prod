/*.html
  Cache-Control: public, max-age=600, s-maxage=600, stale-while-revalidate=60

/
  Cache-Control: public, max-age=600, s-maxage=600, stale-while-revalidate=60

/analyze
  Cache-Control: no-store

/analyze.html
  Cache-Control: no-store

/analyze-assets.json
  Cache-Control: no-store

/analyze-chart.js
